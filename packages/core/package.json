{
  "name": "@sentinel-scan/core",
  "version": "0.1.1",
  "description": "Sentinel core analysis engine — pure, zero runtime dependencies",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsup",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/blaycoder/Sentinel.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/blaycoder/Sentinel#readme",
  "bugs": {
    "url": "https://github.com/blaycoder/Sentinel/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "static-analysis",
    "api",
    "developer-tools",
    "typescript",
    "sentinel"
  ]
}
